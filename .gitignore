# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*
metro.log

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Mural prep tool
tools/mural-prep-godot/exports/
tools/mural-prep-godot/plugin_config.json
tools/mural-prep-godot/test_assets/*
!tools/mural-prep-godot/test_assets/.gitkeep
tools/mural-prep-godot/addons/
.godot/

# Audio working files
# .asd = Ableton analysis sidecars regenerated on every clip drag.
# old/ holds the previous-version SFX kept locally for Ableton's
# session references — Metro never bundles them; only require()'d
# files reach the APK, so keeping them out of git is enough.
assets/audio/*.asd
assets/audio/old/
assets/audio/Untitled.*

# Claude Code runtime state (scheduled-task lock files etc.)
.claude/

# Local Expo module build artifacts. The Kotlin source lives in
# modules/<name>/android/src/; gradle's build/.transforms/ subtree has
# path names long enough to break git add on Windows. Source only —
# build output regenerates from `gradlew bundleRelease`.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/build/
