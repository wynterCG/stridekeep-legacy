{
  "expo": {
    "name": "Stridekeep",
    "slug": "stridekeep",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.stridekeep",
      "versionCode": 5,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "react-native-health-connect",
      "./plugins/withHealthConnectRationale.js",
      "./plugins/withHealthConnectMainActivity.js",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "supabaseUrl": "https://fdygeoihelpgjyhbvxgu.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZkeWdlb2loZWxwZ2p5aGJ2eGd1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY2NjcwMDIsImV4cCI6MjA5MjI0MzAwMn0.IHjRb8LyzpzKR9_18NOOI9oQDy9YuiPTEU_Fsj55eEM"
    }
  }
}
