class_name SeedSQL extends RefCounted

# Stridekeep Mural Prep — Slice 4.
# Build the seed_next_mural() SQL string from a curated palette + recipes +
# target_pixels + canvas dims + mural name + season number.
#
# The RPC signature on the Supabase side (per SKILL.md §9) is:
#   seed_next_mural(target_pixels jsonb, palette jsonb, craft_recipes jsonb,
#                   canvas_width int, canvas_height int, mural_name text)
#
# Output uses PostgreSQL dollar-quoting ($mp$...$mp$) so embedded JSON does
# not need single-quote escaping. The generated string is paste-ready into
# the Supabase SQL editor.
#
# Pure function — no side effects. Test directly with a synthetic palette.

const ValidationLib := preload("res://scripts/validation.gd")
const SeasonExportLib := preload("res://scripts/season_export.gd")

# palette_state matches color_row.get_state() entries.
# recipe_state matches recipe_row.get_state() entries.
# target_pixels: Dictionary { "0": "s1_bone", "1": "s1_charcoal", ... }
static func build(season_num: int, palette_state: Array, recipe_state: Array, target_pixels: Dictionary, width: int, height: int, mural_name: String) -> String:
	# Range-check recipe indices upfront — silent-skip would emit SQL that
	# Postgres rejects with a confusing "color X not found" message far from
	# the actual cause. Validation should already have caught these, but
	# this module is exposed publicly and may be called outside the
	# state-machine flow.
	for r_idx in recipe_state.size():
		var r = recipe_state[r_idx]
		var oi: int = r.output_color_idx
		assert(oi >= 0 and oi < palette_state.size(),
			"SeedSQL.build: recipe %d output_color_idx %d out of range" % [r_idx, oi])
		for inp in r.inputs:
			var ci: int = inp.color_idx
			assert(ci >= 0 and ci < palette_state.size(),
				"SeedSQL.build: recipe %d input color_idx %d out of range" % [r_idx, ci])

	var palette_json := _palette_to_json(season_num, palette_state)
	var recipes_json := _recipes_to_json(season_num, palette_state, recipe_state)
	var pixels_json := JSON.stringify(target_pixels)
	var name_literal := _quote_text(mural_name)
	# Pick a dollar-quote tag that does NOT appear anywhere in the JSON we
	# are about to embed. User-typed color names containing "$mp$" would
	# otherwise terminate the literal early and break SQL parsing.
	var tag := _pick_dollar_tag(palette_json + recipes_json + pixels_json + mural_name)

	return ("-- Generated by Stridekeep Mural Prep — season %d\n" +
		"-- Mural: %s · canvas %d x %d · %d colors · %d recipes\n" +
		"SELECT seed_next_mural(\n" +
		"  p_target_pixels  := $%s$%s$%s$::jsonb,\n" +
		"  p_palette        := $%s$%s$%s$::jsonb,\n" +
		"  p_craft_recipes  := $%s$%s$%s$::jsonb,\n" +
		"  p_canvas_width   := %d,\n" +
		"  p_canvas_height  := %d,\n" +
		"  p_mural_name     := %s\n" +
		");\n") % [
			season_num,
			mural_name,
			width, height,
			palette_state.size(),
			recipe_state.size(),
			tag, pixels_json, tag,
			tag, palette_json, tag,
			tag, recipes_json, tag,
			width,
			height,
			name_literal,
		]

# Build the target_pixels Dictionary { "<idx>": "<color_id>" } from a
# Quantize.map_to_indices result + the palette (so we can map index -> id).
static func build_target_pixels(palette_indices: PackedInt32Array, season_num: int, palette_state: Array) -> Dictionary:
	var ids := PackedStringArray()
	ids.resize(palette_state.size())
	for i in palette_state.size():
		ids[i] = ValidationLib.build_color_id(season_num, palette_state[i].name)
	var out := {}
	for px_idx in palette_indices.size():
		var color_idx := palette_indices[px_idx]
		out[str(px_idx)] = ids[color_idx]
	return out

# ---- JSON serializers --------------------------------------------------------
# Delegate to SeasonExport so the JSON shape has a single source of truth —
# any per-color or per-recipe field changes update both the JSON export and
# the SQL output in lockstep.

static func _palette_to_json(season_num: int, palette_state: Array) -> String:
	return JSON.stringify(SeasonExportLib.palette_to_array(season_num, palette_state))

static func _recipes_to_json(season_num: int, palette_state: Array, recipes: Array) -> String:
	return JSON.stringify(SeasonExportLib.recipes_to_array(season_num, palette_state, recipes))

# Quote a string as a PostgreSQL text literal — single quotes around it,
# escape internal single quotes by doubling them.
static func _quote_text(s: String) -> String:
	return "'%s'" % s.replace("'", "''")

# Pick a short alphanumeric tag for PostgreSQL dollar-quoting that does NOT
# appear anywhere in the corpus. Starts with "mp" and falls back to longer
# tags drawn from the corpus's md5 if the simple one collides.
static func _pick_dollar_tag(corpus: String) -> String:
	if not corpus.contains("$mp$"):
		return "mp"
	var hash_hex := corpus.md5_text()
	for n in range(2, hash_hex.length() + 1):
		var candidate := "mp" + hash_hex.substr(0, n)
		if not corpus.contains("$%s$" % candidate):
			return candidate
	# Theoretical fallback — the full md5 prefix collides somewhere — but
	# corpus would have to be adversarially constructed to reach this.
	return "mp" + hash_hex
